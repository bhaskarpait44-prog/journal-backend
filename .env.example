# ==========================================
# TradeLog Backend Environment Configuration
# ==========================================

# Port the Express server listens on (Render automatically provides PORT)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# Database Connection (Neon PostgreSQL Connection String)
# Example from Neon Dashboard:
# postgresql://neondb_owner:YOUR_PASSWORD@ep-weathered-snow-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# SSL requirement for PostgreSQL (auto-enabled when DATABASE_URL has neon.tech or NODE_ENV=production)
DB_SSL=true

# Set to 'true' if you want Sequelize SQL queries printed to console for debugging
DB_LOGGING=false

# Secret key for signing JSON Web Tokens (min 32 characters recommended in production)
JWT_SECRET=generate_a_secure_random_string_here_for_production_auth

# JWT Expiry duration (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Allowed frontend client URL(s) for CORS. Can be comma-separated.
# E.g.: https://your-app.vercel.app
CLIENT_URL=https://your-app.vercel.app
